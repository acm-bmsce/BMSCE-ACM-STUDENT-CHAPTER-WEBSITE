{
  "name": "bmsce-acm-website",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n \"API,WEB\" -c \"blue,green\" \"npm run dev:server\" \"npm run dev:client\"",
    "dev:client": "vite --host",
    "dev:server": "node --watch server/index.js",
    "build": "node scripts/build.mjs",
    "qa": "node scripts/qa.mjs",
    "qa:perf": "node scripts/lighthouse.mjs",
    "qa:leaks": "node scripts/leak-check.mjs",
    "start": "node server/index.js",
    "preview": "vite preview --port 4173",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "qa:e2e": "node scripts/e2e.mjs",
    "admin:hash": "node scripts/hash-password.mjs"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "lenis": "^1.3.26",
    "lottie-web": "^5.13.0",
    "morgan": "^1.10.0",
    "multer": "^2.5.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.1",
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "globals": "^17.14.0",
    "lighthouse": "^13.6.0",
    "playwright-core": "^1.65.1",
    "rollup-plugin-visualizer": "^7.3.0",
    "supertest": "^7.3.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.2"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.0",
    "minimatch": "^11.0.4"
  }
}
