# ---------------------------------------------------------------- the chapter's backend
# FastAPI + MongoDB (github.com/acm-bmsce/WEBSITE-BACKEND). The website reads events, projects and
# Insight Series stories from it; the admin panel signs in and saves there. The public pages fall
# back to the copies in content/ while it wakes up or if it is down.
# Blank = the default below; "off" = bundled copy only (the admin panel then saves content/ files).
VITE_LIVE_API=https://bmsceacmwebsite.onrender.com
# The same address for this repository's content API, which accepts the backend's sign-ins.
LIVE_API=https://bmsceacmwebsite.onrender.com

# Admin image uploads go to the chapter's Cloudinary account through an unsigned upload preset
# (not secret: it only allows uploads). Defaults shown.
VITE_CLOUDINARY_CLOUD=dzccr1oot
VITE_CLOUDINARY_PRESET=Website-Image

# ---------------------------------------------------------------- where content/ saves go
# With a token, every save to content/ (drafts, website-only event details, story years, Pages &
# team) is a commit to GITHUB_REPO on GITHUB_BRANCH and Vercel redeploys the site (about a minute).
# Use a fine-grained personal access token limited to that one repository with
# "Contents: Read and write". Leave it empty locally: saves then write the content/ files here.
GITHUB_TOKEN=
# On Vercel these default to the repository and branch being deployed.
GITHUB_REPO=
GITHUB_BRANCH=

# ---------------------------------------------------------------- optional: sign-ins without the backend
# Extra accounts for the content API only (username:bcrypt-hash pairs, comma-separated; make one
# with `npm run admin:hash -- <username>`). Only used when VITE_LIVE_API is "off".
ADMIN_USERS=
# Needed only with ADMIN_USERS: 32+ random characters, e.g. `openssl rand -hex 32`.
JWT_SECRET=
JWT_EXPIRES_IN=12h

# ---------------------------------------------------------------- server
NODE_ENV=development
PORT=5000
# The website's address (CORS); same-origin requests are always allowed.
FRONTEND_URL=http://localhost:5173
# Reverse-proxy hops in front of the API (defaults to 1 in production). "false" when reached directly.
TRUST_PROXY=
# Serve the built website (dist/) from the API server too: one service for everything.
SERVE_WEB=false

# Where the website finds the content API. Leave blank: /api on the site's own address (dev and
# `vite preview` proxy it to localhost:5000; on Vercel it's the same deployment).
VITE_API_URL=
