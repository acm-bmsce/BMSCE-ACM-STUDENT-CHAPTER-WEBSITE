# Cloudflare Pages response headers (the same rules as vercel.json). The Content-Security-Policy
# itself is written into index.html at build time (vite.config.js); frame-ancestors only works
# as a header, so it is here.
/*
  Content-Security-Policy: frame-ancestors 'none'; object-src 'none'; base-uri 'self'
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin-allow-popups

/index.html
  Cache-Control: no-cache

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/Fonts/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400

/img/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/animations/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/video/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
